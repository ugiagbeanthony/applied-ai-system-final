flowchart TD
    %% INPUT
    Player([Player / Browser])

    subgraph UI["Streamlit App (app.py)"]
        Input[Guess input and difficulty]
        State[(Session state: secret, attempts, score, history)]
        Display[Result, coach hint and score]
    end

    subgraph Logic["Game Logic (logic_utils.py)"]
        Parse[parse_guess]
        Check[check_guess]
        Score[update_score]
        Narrow[narrow_range]
    end

    subgraph Coach["AI Hint Coach (hint_coach.py)"]
        KB[(knowledge/strategy.md)]
        Retriever[Retriever: match situation to notes]
        Agent[Generator: model hint, or offline hint if no key]
        Guard{Evaluator: leaks secret or too long?}
        Fallback[Safe local hint]
    end

    subgraph QA["Testing and Monitoring"]
        Tests[pytest: logic, retrieval, guardrail, retry, fallback]
        Log[game.log: guesses, retrieval, rejections, errors]
    end

    %% PROCESS
    Player -->|guess| Input
    Input --> Parse --> Check
    State -->|secret| Check
    Check -->|outcome| Score --> State
    Check --> Narrow
    Narrow -->|remaining range| Retriever
    KB --> Retriever
    Retriever -->|top notes| Agent
    Agent --> Guard
    Guard -->|rejected: retry once| Agent
    Guard -->|rejected twice or API error| Fallback
    Guard -->|approved| Display
    Fallback --> Display

    %% OUTPUT AND HUMAN CHECK
    Display -->|hint and result| Player
    Player -.->|human check: is the hint helpful and honest?| Display

    %% TESTING
    Tests -.->|verifies| Parse
    Tests -.->|verifies| Check
    Tests -.->|verifies| Score
    Tests -.->|verifies| Retriever
    Tests -.->|verifies| Guard
    Tests -.->|verifies| Fallback
    Coach -.->|logs| Log
    Logic -.->|logs| Log
    Log -.->|developer reviews| Tests
